extends SceneTree
## One-off builder for scenes/maps/hills.tscn: terrain node, environment, player
## start, scattered woods and bushes, MG nests and target tanks, all snapped to the
## terrain generated by tools/generate_hills.gd. Run once:
##   godot --headless --path . --script res://tools/build_hills_scene.gd
## After that the scene belongs to the editor; rerunning overwrites your edits.

const OUT: String = "res://scenes/maps/hills.tscn"
const TERRAIN_DIR: String = "res://terrain/hills"
## Ridge centre line, same formula as the generator.
const RIDGE_BASE_Z: float = -100.0

var _root: Node3D
var _terrain: Terrain3D
var _frames: int = 0


func _initialize() -> void:
	_root = Node3D.new()
	_root.name = "Hills"
	root.add_child(_root)
	_terrain = Terrain3D.new()
	_terrain.name = "Terrain3D"
	_terrain.material = load(TERRAIN_DIR + "/material.tres")
	_terrain.assets = load(TERRAIN_DIR + "/assets.tres")
	_terrain.data_directory = TERRAIN_DIR
	_terrain.collision_mode = 3  # Full / Game: shells and nests act far from the camera
	_add(_root, _terrain)


func _process(_delta: float) -> bool:
	_frames += 1
	if _frames < 3:
		return false  # Terrain3D loads its data a frame after entering the tree
	_build()
	var packed := PackedScene.new()
	var err: int = packed.pack(_root)
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path("res://scenes/maps"))
	print("pack: %d, save: %d" % [err, ResourceSaver.save(packed, OUT)])
	_strip_instance_overrides()
	return true


## Packing after the nodes ran _ready() stores copies of values the instanced scenes
## already have (mass, script, data...). Drop them so edits to tank.tscn and
## mg_nest.tscn still reach this map. Only transform and real overrides stay.
func _strip_instance_overrides() -> void:
	const KEEP: Array[String] = ["transform", "paint_color"]
	var lines: PackedStringArray = FileAccess.get_file_as_string(OUT).split("\n")
	var out := PackedStringArray()
	var in_instance: bool = false
	for line: String in lines:
		if line.begins_with("["):
			in_instance = line.contains("instance=") and (line.contains("RigidBody3D")
					or line.contains("StaticBody3D"))
		elif in_instance and line.contains(" = ") and not KEEP.has(line.get_slice(" = ", 0)):
			continue
		out.append(line)
	var file := FileAccess.open(OUT, FileAccess.WRITE)
	file.store_string("\n".join(out))


func _build() -> void:
	_add_environment()
	var rig: Node3D = load("res://scenes/player/player_rig.tscn").instantiate()
	rig.name = "PlayerRig"
	_add(_root, rig)
	rig.global_position = _ground(0.0, 700.0)

	var vegetation := _group("Vegetation")
	_scatter(vegetation, "WoodsWest", "tree", Vector2(-320, _ridge_z(-320)), 130.0, 70, 1)
	_scatter(vegetation, "WoodsEast", "tree", Vector2(380, _ridge_z(380)), 110.0, 55, 2)
	_scatter(vegetation, "LoneTrees", "tree", Vector2(0, 150), 650.0, 30, 3)
	_scatter(vegetation, "BushesNear", "bush", Vector2(0, 330), 260.0, 140, 4)
	_scatter(vegetation, "BushesValley", "bush", Vector2(-150, -460), 260.0, 110, 5)
	_scatter(vegetation, "BushesAroundNestB", "bush", Vector2(250, 140), 12.0, 7, 6)

	var nests := _group("MGNests")
	var nest_scene: PackedScene = load("res://scenes/world/mg_nest.tscn")
	_place(nests, nest_scene, "NestRidge", -120.0, _ridge_z(-120.0) + 60.0)
	_place(nests, nest_scene, "NestBushes", 250.0, 150.0)

	var enemies := _group("Enemies")
	var tank_scene: PackedScene = load("res://scenes/tank/tank.tscn")
	var controller_script: Script = load("res://scripts/control/target_tank_controller.gd")
	var sand := Color(0.62, 0.55, 0.4, 1)
	var static_tank: Tank = _place(enemies, tank_scene, "EnemyStatic", -60.0, 260.0, 1.5)
	static_tank.rotation.y = PI * 0.85
	static_tank.paint_color = sand
	var patrol_tank: Tank = _place(enemies, tank_scene, "EnemyPatrol", -300.0, -480.0, 1.5)
	patrol_tank.rotation.y = -PI * 0.5
	patrol_tank.paint_color = sand
	for pair: Array in [["EnemyStaticController", static_tank, 0], ["EnemyPatrolController", patrol_tank, 1]]:
		var controller := Node.new()
		controller.name = pair[0]
		controller.set_script(controller_script)
		_add(enemies, controller)
		controller.set("tank", pair[1])
		controller.set("mode", pair[2])
	enemies.get_node("EnemyPatrolController").set("waypoints",
			[Vector3(-300, 0, -480), Vector3(300, 0, -480)] as Array[Vector3])


func _add_environment() -> void:
	var sky_material := ProceduralSkyMaterial.new()
	var sky := Sky.new()
	sky.sky_material = sky_material
	var environment := Environment.new()
	environment.background_mode = Environment.BG_SKY
	environment.sky = sky
	environment.tonemap_mode = Environment.TONE_MAPPER_FILMIC
	# Distance haze: spotting gets harder with range. Tune in the editor.
	environment.fog_enabled = true
	environment.fog_light_color = Color(0.68, 0.73, 0.8)
	environment.fog_density = 0.0006
	environment.fog_aerial_perspective = 0.4
	environment.fog_sky_affect = 0.25
	var world_environment := WorldEnvironment.new()
	world_environment.name = "WorldEnvironment"
	world_environment.environment = environment
	_add(_root, world_environment)
	var sun := DirectionalLight3D.new()
	sun.name = "Sun"
	sun.rotation_degrees = Vector3(-50, 30, 0)
	sun.shadow_enabled = true
	sun.directional_shadow_max_distance = 300.0
	_add(_root, sun)


func _scatter(parent: Node, node_name: String, kind: String, centre: Vector2, radius: float,
		count: int, random_seed: int) -> void:
	var scatter := Scatter.new()
	scatter.name = node_name
	_add(parent, scatter)
	scatter.global_position = _ground(centre.x, centre.y)
	scatter.scene = load("res://scenes/world/%s.tscn" % kind)
	scatter.terrain = _terrain
	scatter.radius_m = radius
	scatter.count = count
	scatter.random_seed = random_seed
	if kind == "bush":
		scatter.min_scale = 0.7
		scatter.max_scale = 1.4
	print("%s: placed %d" % [node_name, scatter.regenerate_now()])


func _place(parent: Node, scene: PackedScene, node_name: String, x: float, z: float,
		lift: float = 0.0) -> Node3D:
	var node := scene.instantiate() as Node3D
	node.name = node_name
	_add(parent, node)
	node.global_position = _ground(x, z) + Vector3(0.0, lift, 0.0)
	return node


func _group(node_name: String) -> Node3D:
	var node := Node3D.new()
	node.name = node_name
	_add(_root, node)
	return node


func _add(parent: Node, node: Node) -> void:
	parent.add_child(node)
	node.owner = _root


func _ground(x: float, z: float) -> Vector3:
	return Vector3(x, _terrain.data.get_height(Vector3(x, 0.0, z)), z)


func _ridge_z(x: float) -> float:
	return RIDGE_BASE_Z + 90.0 * sin(x / 380.0)
