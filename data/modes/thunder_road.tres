[resource]
script = ExtResource("1_data")
display_name = "ThunderRoad"
calls = ExtResource("calls")
briefing = "Attackers push along the road: more tanks than the defenders in a checkpoint takes it.\nEvery checkpoint has the same time; taking one brings lives, a wave and a 40 s pause: attackers hold, defenders fall back to the next (both may still fire).\nDefenders hold a corridor along the road and fall back as the front moves.\nOutside your corridor your guns are silent, and after 30 s you are out.\nPoints: taking and holding checkpoints pays far more than kills.\nTwo rounds, sides swap. Most checkpoints wins."
defender_half_width_m = 350.0
defender_behind_front_m = 150.0
attacker_half_width_m = 400.0
attacker_ahead_of_checkpoint_m = 100.0
outside_mark_s = 4.0
outside_knockout_s = 30.0
start_front_m = 150.0
capture_half_width_m = 160.0
capture_half_length_m = 60.0
capture_time_s = 20.0
capture_speed_max = 2.0
capture_decay_factor = 0.5
pause_s = 40.0
pause_attacker_ahead_m = 50.0
pause_defender_back_m = 200.0
checkpoint_time_s = 360.0
start_lives_per_tank = 2
start_lives_extra = 5
lives_per_capture = 2
wave_interval_s = 30.0
attacker_spawn_back_m = 250.0
defender_respawn_s = 15.0
defender_spawn_checkpoints = 1
defender_spawn_beyond_m = 210.0
defender_spawn_min_ahead_m = 470.0
defender_start_in_zone = true
kill_points = 20.0
assist_points = 10.0
capture_points = 100.0
capture_points_per_s = 2.0
defend_points_per_s = 2.0
hold_points = 100.0
round_break_s = 10.0
bot_configs = Array[ExtResource("2_cfg")]([ExtResource("c0"), ExtResource("c1"), ExtResource("c2"), ExtResource("c3"), ExtResource("c4")])
defender_repost_min_s = 60.0
defender_repost_max_s = 120.0
