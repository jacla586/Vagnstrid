[resource]
script = ExtResource("1_koth")
bot_attack_axes = true
display_name = "King of the Hill"
briefing = "Zones open one at a time; the next one shows on the map.\nEvery tank of yours inside the zone scores. More tanks there than the enemy: faster.\nZones shrink as they go, then close.\nA knock-out in the zone from inside it gives a bonus.\nFirst team to {score} points wins."
