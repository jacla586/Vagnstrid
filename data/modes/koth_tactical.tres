[resource]
script = ExtResource("1_koth")
display_name = "King of the Hill – tactical"
briefing = "Zones open one at a time; the next one shows on the map.\nEvery tank of yours inside the zone scores. More tanks there than the enemy: faster.\nA slower game: zones shrink little and last long.\nKnocking out any enemy inside the zone gives a bonus.\nFirst team to {score} points wins."
radius_start_m = 175.0
radius_end_m = 110.0
zone_hold_s = 240.0
zone_lifetime_s = 420.0
zone_gap_s = 75.0
points_per_tank_end = 2.5
kill_bonus_needs_shooter_in_zone = false
zone_placement = 1
bot_attack_axes = true
assembly_distance_m = 300.0
support_per_team = 1
spawn_distance_m = 650.0
bot_respawn_delay_s = 22.0
bot_configs = Array[ExtResource("2_cfg")]([ExtResource("c0"), ExtResource("c1"), ExtResource("c2"), ExtResource("c3"), ExtResource("c4")])
calls = ExtResource("calls_koth_calls_sv")
