[configuration]

entry_symbol = "vagnfast_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libvagnfast.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libvagnfast.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libvagnfast.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libvagnfast.windows.template_release.x86_64.dll"
